/-- **Rung 4 headline.** Every candidate `n > 10^11` has its residue class
mod 17·19·23·29 among the 4431 rung-4 survivors. -/
theorem classOk4_of_cand {n : ℕ} (hn : 100000000000 < n)
    (H : Erdos647Mod.Cand n) : classOk4 n = true := by
  have hL : 360360 ∣ n := Erdos647Mod.mod360360_of_cand (by omega) H
  have hp := Erdos647Mod.mod_17_19_of_cand (by omega) H
  simp only [Erdos647Mod.survivors, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h
  · rw [Prod.mk.injEq] at h
    exact rung4_resolve (p := 0) hn H hL (by omega) rfl rfl h.1 h.2
  · rw [Prod.mk.injEq] at h
    exact rung4_resolve (p := 1) hn H hL (by omega) rfl rfl h.1 h.2
  · rw [Prod.mk.injEq] at h
    exact rung4_resolve (p := 2) hn H hL (by omega) rfl rfl h.1 h.2
  · rw [Prod.mk.injEq] at h
    exact rung4_resolve (p := 3) hn H hL (by omega) rfl rfl h.1 h.2
  · rw [Prod.mk.injEq] at h
    exact rung4_resolve (p := 4) hn H hL (by omega) rfl rfl h.1 h.2
  · rw [Prod.mk.injEq] at h
